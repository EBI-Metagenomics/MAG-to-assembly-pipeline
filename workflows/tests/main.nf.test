nextflow_workflow {

    name "Test workflows/mag-assembly_linking.nf"
    script "../mag-assembly_linking.nf"
    workflow "MAG_ASSEMBLY_LINKING_PIPELINE"

    test("Run the pipeline on the test dataset") {

        when {
            params {
                    // required files
                    gut_mapping         = "${projectDir}/data/known_and_found_gut_genomes.tsv"

                    // user input args
                    previous_mapping    = "${moduleDir}/tests/data/mag_to_assembly_links.tsv"
                    skip_accessions     = "${moduleDir}/tests/data/processed_accessions.tsv"
                    accessions_list     = "${moduleDir}/tests/data/input_accessions_small.tsv"
                    catalogues_metadata = "${moduleDir}/tests/data/all_catalog_metadata.tsv"
                    output_path         = "${outputDir}"
            }
        }

        then {
            assert workflow.success

            with(workflow.out.mag_to_assembly_mapping) {
                // check header
                assert path(get(0)).readLines().contains('Primary_assembly	MAG_accession	Genome	Species_rep')
                // check that line from previous table is present
                assert path(get(0)).readLines().contains('ERZ1311121	ERZ973106	MGYG000028474	MGYG000001300')
                // check that new lines from current run are added
                assert path(get(0)).readLines().contains('ERZ6864471	GCA_938030915	MGYG000484098	MGYG000484098')
            }
            with(workflow.out.processed_accessions) {
                // check that processed accessions from previous run are present
                assert path(get(0)).readLines().contains('ERZ1051661')
                // check that accessions from current run are added to the list of processed accessions
                assert path(get(0)).readLines().contains('GCA_938030915')
                assert path(get(0)).readLines().contains('RSAC01')
            }
        }
    }
}
