nextflow_process {

    name "Test Process VERIFY_CONTIG_HASHES_MATCH"
    script "../main.nf"
    process "VERIFY_CONTIG_HASHES_MATCH"

    test("Find assemblies for the test list of accessions") {

        when {
            params {
                portion_size = 2
            }
            process {
                """
                input[0] = Channel.fromPath("${moduleDir}/tests/data/input_mapping.tsv", checkIfExists: true)
                    .splitText(by: 2, file: "batch")
                    .map { batch_file ->
                        def meta = [id: batch_file.name]
                        [meta, batch_file]
                    }
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
