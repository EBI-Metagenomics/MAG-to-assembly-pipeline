params {
    // required files
    gut_accessions_mapping = "${projectDir}/data/known_and_found_gut_genomes.tsv"

    // user input args
    batch_size             = 250
    merge_with_results     = null
    skip_accessions        = null
    accessions_list        = null
    catalogues_metadata    = null
    cleanup                = true
    debug                  = false
    output_path            = "${System.getenv('PWD')}/results"
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
includeConfig 'conf/test_local.config'

profiles {
    codon_slurm {
        includeConfig 'conf/codon_slurm.config'
    }
    docker {
        docker.runOptions = '-u $(id -u):$(id -g)'
        docker.registry   = 'quay.io'
        docker.enabled    = true
    }
    arm {
        docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${System.getenv('HOME')}/.singularity"
    }
    test {
        process {
            resourceLimits = [
                cpus: 2,
                memory: 1.GB,
                time: 1.h,
            ]
        }
    }
}
