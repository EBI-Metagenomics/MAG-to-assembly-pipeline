params {
    // required files
    gut_accessions_mapping = "$projectDir/data/known_and_found_gut_genomes.tsv"

    // user input args
    batch_size             = 250
    merge_with_results     = null
    skip_accessions        = null
    accessions_list        = null
    catalogues_metadata    = null
    cleanup                = true
    debug                  = false
    output_path            = "$PWD/results"
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    codon_slurm {
        includeConfig 'conf/codon_slurm.config'
    }
    test_local {
        includeConfig 'conf/test_local.config'
    }
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${HOME}/.singularity"
    }
    test {
        process {
            resourceLimits = [
                cpus: 2,
                memory: 1.GB,
                time: 1.h
            ]
        }
    }
}
