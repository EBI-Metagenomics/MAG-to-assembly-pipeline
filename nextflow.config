params {
    // Accession mapping file for "human gut" catalogue of MGnify - DO NOT MODIFY OR DELETE
    // This file complements metadata for the "human gut" catalogue of MGnify by converting
    // custom MGYG accessions (which cannot be used with ENA API) to ENA-compatible accessions.
    // Essential for proper metadata retrieval and processing of genomes from this catalogue.
    gut_accessions_mapping = "${projectDir}/data/known_and_found_gut_genomes.tsv"

    // user input args
    batch_size             = 250
    merge_with_results     = null
    skip_accessions        = null
    accessions_list        = null
    catalogues_metadata    = null
    cleanup                = true
    debug                  = false
    output_path            = "${projectDir}/results"
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
includeConfig 'conf/local.config'

profiles {
    codon_slurm {
        includeConfig 'conf/codon_slurm.config'
    }
    docker {
        docker.runOptions = '-u $(id -u):$(id -g)'
        docker.registry   = 'quay.io'
        docker.enabled    = true
    }
    arm {
        docker.runOptions = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${System.getenv('HOME')}/.singularity"
    }
    test {
        params {
            cleanup = false
            debug   = true
        }
        process {
            resourceLimits = [
                cpus: 2,
                memory: 1.GB,
                time: 1.h,
            ]
        }
    }
}
